# Copy to .env and fill in. .env is gitignored.

# Reed - free API key from https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# Adzuna - free app id + key from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Notion - internal integration token from https://www.notion.so/my-integrations
# The database must be shared with the integration before n8n can write to it.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Anthropic - scores each job against the CV
ANTHROPIC_API_KEY=

# Resend - sends the digest emails. Free tier, no domain verification needed:
# https://resend.com/api-keys. The default sender (onboarding@resend.dev) can
# only send to the address your Resend account is registered under, so
# DIGEST_EMAIL_TO below must be that same address.
RESEND_API_KEY=

# Where digests are sent - must match the email your Resend account uses
DIGEST_EMAIL_TO=
