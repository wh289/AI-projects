{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(./core/policy.py)",
      "Write(./core/policy.py)",
      "Edit(./core/action_layer.py)",
      "Write(./core/action_layer.py)",
      "Edit(./core/orchestrator.py)",
      "Write(./core/orchestrator.py)",
      "Read(./.env)",
      "Bash(git push:*)"
    ],
    "allow": [
      "Bash(pytest:*)",
      "Bash(python:*)",
      "Bash(pip install:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Read(./**)",
      "Edit(./tests/**)",
      "Edit(./web/**)",
      "Edit(./evals/**)"
    ]
  }
}
